# Example environment variables (do NOT put real secrets here)
# Copy this file to .env and fill with real values (ensure .env is in .gitignore)

# JWT secret (minimum 256-bit length recommended)
JWT_SECRET=your-secure-jwt-secret-here
# Example generated secret (replace in production): SZIVXNiPQWPJQOjpTaZ0tjfsZiQJBdlQa4iByCPUWzU=

# Kafka SASL passwords
KAFKA_ADMIN_PASSWORD=change-me
KAFKA_APP_PASSWORD=change-me

# Database password
SPRING_DATASOURCE_PASSWORD=flowboard_pass

# Other environment variables
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
